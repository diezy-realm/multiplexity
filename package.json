{
  "name": "vm-login-dashboard",
  "version": "0.3.0",
  "private": true,
  "description": "Internal VM, SSH and database manager for web and desktop",
  "main": "desktop/main.cjs",
  "engines": {
    "node": "^22.12.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "bcrypt": true,
    "esbuild": true,
    "ssh2": true,
    "cpu-features": true,
    "unrs-resolver": true,
    "electron-winstaller": false
  },
  "scripts": {
    "dev": "node scripts/rust-web.cjs",
    "dev:server": "cargo run --manifest-path rust/Cargo.toml --bin multiplexity-server",
    "build:web": "vite build",
    "build": "npm run build:web && cargo build --manifest-path rust/Cargo.toml --release",
    "desktop:build": "node scripts/rust-desktop.cjs --build --no-bundle",
    "desktop:start": "node scripts/rust-desktop.cjs",
    "desktop:dev": "node scripts/rust-desktop.cjs",
    "desktop:smoke": "node tests/rust/desktop-smoke.cjs",
    "desktop:test": "npm run rust:test && npm run rust:smoke",
    "desktop:pack": "node scripts/rust-desktop.cjs --build --no-bundle",
    "desktop:dist": "node scripts/rust-desktop.cjs --build",
    "start": "node scripts/rust-web.cjs --production",
    "legacy:dev": "node scripts/local-web.cjs",
    "legacy:build": "node scripts/build.cjs",
    "legacy:desktop": "node scripts/local-web.cjs --electron",
    "legacy:desktop:test": "node --test tests/desktop/*.test.cjs",
    "legacy:desktop:smoke": "electron . --desktop-smoke-test",
    "legacy:web:test": "node scripts/build.cjs && node --test --test-concurrency=1 tests/web/*.test.cjs",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:smoke": "cargo build --manifest-path rust/Cargo.toml --bin multiplexity-server && node tests/rust/smoke.cjs",
    "rust:browser:test": "node tests/rust/run-browser.cjs",
    "rust:dev:test": "node tests/rust/dev-smoke.cjs",
    "rust:check": "cargo clippy --manifest-path rust/Cargo.toml --all-targets -- -D warnings",
    "tauri": "tauri",
    "web:test": "npm run build:web && npm run rust:smoke && npm run rust:browser:test && npm run rust:dev:test",
    "lint": "eslint src server.ts vite.config.mts --ext .ts,.tsx",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "db:seed": "npx tsx src/lib/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "desktop:smoke:packaged": "node tests/rust/desktop-smoke.cjs",
    "legacy:desktop:smoke:packaged": "node scripts/smoke-packaged.cjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lobehub/icons-static-svg": "^1.106.0",
    "@radix-ui/react-select": "2.4.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "codemirror": "^6.0.1",
    "cookie": "^1.1.1",
    "dotenv": "16.6.1",
    "jose": "5.10.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.80.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "9.1.0",
    "react-router-dom": "7.18.7",
    "remark-gfm": "4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.17.0",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vercel/nft": "1.11.12",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^8",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "^4.1.5"
  }
}
