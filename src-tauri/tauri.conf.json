{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multiplexity",
  "version": "0.3.0",
  "identifier": "com.multiplexity.desktop.rust",
  "build": {
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://localhost:*; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/brand/multiplexity.ico"],
    "resources": { "../dist/client/": "frontend/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "compression": "lzma" }
    }
  }
}
